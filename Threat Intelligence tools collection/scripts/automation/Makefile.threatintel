PYTHON ?= python3
VENV ?= .venv
REQS = scripts/requirements.txt
IOC_FILE ?= data/examples/sample_intel_case.json
OUT_FILE ?= data/outputs/last_report.json

.PHONY: help venv install lint collect report test

help:
	@echo "Targets disponíveis:"
	@echo "  make venv     -> cria ambiente virtual"
	@echo "  make install  -> instala dependências"
	@echo "  make collect  -> normaliza IOCs usando o sample"
	@echo "  make report   -> mostra resumo do último relatório"
	@echo "  make test     -> roda pytest"

venv:
	$(PYTHON) -m venv $(VENV)

install:
	$(VENV)/bin/pip install -r $(REQS)

lint:
	$(VENV)/bin/python -m compileall scripts

collect:
	$(VENV)/bin/python scripts/ti_collector.py --ioc-file $(IOC_FILE) --out $(OUT_FILE)

report:
	@cat $(OUT_FILE)

test:
	$(VENV)/bin/python -m pytest tests
